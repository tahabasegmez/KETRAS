<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A Mapsui map for Avalonia that draws a mission plan, fences, zones, points of interest and live aircraft, and turns pointer gestures into edit intents.</Description>
    <PackageTags>avalonia;mapsui;map;mission;gcs;uav</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Mapsui.Avalonia" />
    <PackageReference Include="Mapsui.Nts" />
    <PackageReference Include="BruTile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ketras.Model\Ketras.Model.csproj" />
    <ProjectReference Include="..\Ketras.Theme\Ketras.Theme.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ketras.Tests" />
  </ItemGroup>
</Project>
