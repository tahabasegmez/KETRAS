<!-- A work-area screen (docs/UI_RULES.md "Settings and log split"): the page list on Chrome at the left, an optional banner
     over the page, and the screen's log behind a draggable splitter at the right. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:common="using:Ketras.App.Common"
             xmlns:r="using:Ketras.App.Resources"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="Ketras.App.Common.SplitScreenView"
             x:DataType="common:SplitScreenViewModel">
  <Grid ColumnDefinitions="260,*">
    <!-- Page list -->
    <Border Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="35" Padding="20,0,6,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="panel-title" Text="{Binding NavTitle}" VerticalAlignment="Center" />
            <Button x:Name="NavAction" Grid.Column="1" Classes="row-action" Command="{Binding NavCommand}" ToolTip.Tip="{Binding NavTip}"
                    IsVisible="{Binding NavCommand, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center">
              <lucide:LucideIcon Kind="{Binding NavIcon, Converter={x:Static common:Converters.Icon}}" Size="{StaticResource Size.RowIcon}" />
            </Button>
          </Grid>
        </Border>
        <ListBox x:Name="PageList" Classes="rows" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="common:ScreenPage">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,4,0">
                <lucide:LucideIcon Kind="{Binding Icon, Converter={x:Static common:Converters.Icon}}" Size="{StaticResource Size.RowIcon}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="6,0" />
                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource Brush.Warning}" IsVisible="{Binding NeedsAttention}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid x:Name="Split" Grid.Column="1" Background="{DynamicResource Brush.Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <Panel>
        <DockPanel x:Name="Page" Margin="28,20,12,0">
          <ContentControl x:Name="Banner" DockPanel.Dock="Top" Content="{Binding Banner}" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ContentControl Content="{Binding SelectedPage.Content}" />
        </DockPanel>
        <Button Classes="row-action" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                IsVisible="{Binding !IsLogVisible}" Command="{Binding ShowLogCommand}" ToolTip.Tip="{x:Static r:Strings.LogShow}">
          <lucide:LucideIcon Kind="PanelRightOpen" Size="{StaticResource Size.RowIcon}" />
        </Button>
      </Panel>

      <GridSplitter Grid.Column="1" Width="4" Margin="-2,0" Background="Transparent" ResizeDirection="Columns" ZIndex="1"
                    IsVisible="{Binding IsLogVisible}" />

      <!-- Log -->
      <Border x:Name="LogPane" Grid.Column="2" IsVisible="{Binding IsLogVisible}"
              Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="30" Padding="20,0,8,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="panel-title" Text="{Binding LogTitle}" />
                <TextBlock x:Name="LogCount" Classes="caption mono" Text="{Binding Log.Count}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="row-action" Command="{Binding Log.ClearCommand}" ToolTip.Tip="{x:Static r:Strings.LogClear}">
                  <lucide:LucideIcon Kind="BrushCleaning" Size="{StaticResource Size.RowIcon}" />
                </Button>
                <Button Classes="row-action" Command="{Binding HideLogCommand}" ToolTip.Tip="{x:Static r:Strings.LogHide}">
                  <lucide:LucideIcon Kind="PanelRightClose" Size="{StaticResource Size.RowIcon}" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Classes="small wrap" Text="{Binding LogEmptyText}" IsVisible="{Binding Log.IsEmpty}" Margin="12,8" />
              <ItemsControl ItemsSource="{Binding Log.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="common:LogRow">
                    <Border Padding="12,4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                            Background="{Binding Level, Converter={x:Static common:Converters.SeverityTint}}">
                      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <lucide:LucideIcon Kind="{Binding Level, Converter={x:Static common:Converters.SeverityIcon}}"
                                           Foreground="{Binding Level, Converter={x:Static common:Converters.SeverityBrush}}"
                                           Size="{StaticResource Size.ChevronIcon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding Time}" Margin="0,1,0,0" />
                        <TextBlock Grid.Column="2" Classes="small wrap" Text="{Binding Text}" Foreground="{DynamicResource Brush.Text}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
