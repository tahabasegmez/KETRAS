<!-- The "?" next to a control (docs/UI_RULES.md "Help mark"): a 14 px question mark in Muted, Text under the pointer;
     its Text shows as a tooltip at once, to the right. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="Ketras.App.Common.HelpMark"
             Width="18" Height="18" Background="Transparent" Cursor="Help" VerticalAlignment="Center"
             ToolTip.ShowDelay="0" ToolTip.Placement="Right">
  <UserControl.Styles>
    <Style Selector="lucide|LucideIcon#Mark">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style Selector="UserControl:pointerover lucide|LucideIcon#Mark">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
  </UserControl.Styles>
  <lucide:LucideIcon x:Name="Mark" Kind="CircleQuestionMark" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
</UserControl>
