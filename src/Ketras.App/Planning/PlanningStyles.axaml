<!-- The planner's own look, as the KetrasPlanner control drew it: the floating panel's joined switch, labelled tool faces
     (phase and fence tools) that light up while armed, the view column's square toggles, collapsible section headers,
     list rows with a category bar whose fields open under them. The press-and-hold item strip draws itself
     (Planning/PhasePicker) because it lives in the window's overlay layer. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="using:Ketras.App.Common"
        xmlns:lucide="using:Lucide.Avalonia">
  <Styles.Resources>
    <SolidColorBrush x:Key="Planner.DetailFill" Color="{DynamicResource Color.Selected}" Opacity="0.35" />
    <SolidColorBrush x:Key="Planner.DetailFrame" Color="{DynamicResource Color.Focus}" Opacity="0.5" />
    <SolidColorBrush x:Key="Planner.ExecutingFill" Color="{DynamicResource Color.Executing}" Opacity="0.18" />
    <SolidColorBrush x:Key="Planner.ArmedFill" Color="{DynamicResource Color.Accent}" Opacity="0.25" />
    <SolidColorBrush x:Key="Planner.FaceFrame" Color="{DynamicResource Color.TextStrong}" Opacity="0.07" />

    <ControlTheme x:Key="{x:Type common:CollapsibleSection}" TargetType="common:CollapsibleSection">
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <Border Name="PART_Header" Height="{StaticResource Size.RowHeight}" Padding="4,0" Background="Transparent" Cursor="Hand"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                <lucide:LucideIcon Name="PART_Chevron" Kind="ChevronDown" Size="{StaticResource Size.RowIcon}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="2" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="common|CollapsibleSection[IsExpanded=False] /template/ lucide|LucideIcon#PART_Chevron">
    <Setter Property="Kind" Value="ChevronRight" />
  </Style>

  <!-- The panel's joined switch: Input fill, BorderStrong frame; the chosen half on Selected with a Focus frame. -->
  <Style Selector="Border.panel-switch">
    <Setter Property="Height" Value="{StaticResource Size.ControlHeight}" />
    <Setter Property="Margin" Value="8,6" />
    <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
  </Style>
  <Style Selector="Border.switch-highlight">
    <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Button.switch-half">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
  </Style>
  <Style Selector="Button.switch-half /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.switch-half.active">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
  </Style>
  <Style Selector="Button.switch-half lucide|LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
  </Style>
  <Style Selector="Button.switch-half.active lucide|LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
  </Style>
  <Style Selector="TextBlock.switch-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Labelled tool face (phase picker, fence tools): a secondary button with an icon in the tool's colour; armed is
       Accent at 25 % with an Accent frame. -->
  <Style Selector="Button.tool-face">
    <Setter Property="Height" Value="{StaticResource Size.ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.tool-face /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
    <Setter Property="BorderBrush" Value="{StaticResource Planner.FaceFrame}" />
  </Style>
  <Style Selector="Button.tool-face:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Button.tool-face.armed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Planner.ArmedFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <!-- The press-and-hold phase buttons (PhasePicker): labelled tool faces with the phase's icon colour. -->
  <Style Selector="Border.phase-face">
    <Setter Property="Height" Value="{StaticResource Size.ControlHeight}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
    <Setter Property="BorderBrush" Value="{StaticResource Planner.FaceFrame}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
  </Style>
  <Style Selector="Border.phase-face.armed">
    <Setter Property="Background" Value="{StaticResource Planner.ArmedFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Border.phase-face TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- The view column's square toggles: 28 px, radius 4, no frame until lit. -->
  <Style Selector="Button.view-toggle">
    <Setter Property="Width" Value="{StaticResource Size.ToolButton}" />
    <Setter Property="Height" Value="{StaticResource Size.ToolButton}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.view-toggle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.view-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Planner.ArmedFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.view-toggle lucide|LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Faint}" />
  </Style>
  <Style Selector="Button.view-toggle.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Planner.ArmedFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.view-toggle.on lucide|LucideIcon, Button.view-toggle:pointerover lucide|LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
  </Style>

  <!-- List row: 22 px, a 2 px category bar, number, icon, name, and the value that gives way to the actions while the
       row is hovered or selected. Selected is Selected with a Focus frame; the vehicle's current item is tinted. -->
  <Style Selector="Button.item-row">
    <Setter Property="Height" Value="{StaticResource Size.RowHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,0,4,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.item-row /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.item-row.executing /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Planner.ExecutingFill}" />
  </Style>
  <Style Selector="Button.item-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Button.item-row.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
  </Style>
  <Style Selector="Button.item-row StackPanel.row-actions">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.item-row:pointerover StackPanel.row-actions, Button.item-row.selected StackPanel.row-actions">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.item-row:pointerover TextBlock.row-value, Button.item-row.selected TextBlock.row-value">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.item-row TextBlock.row-name">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.item-row.selected TextBlock.row-name">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
  </Style>
  <Style Selector="TextBlock.row-value">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.row-number">
    <Setter Property="Width" Value="16" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Faint}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.row-bar">
    <Setter Property="Width" Value="2" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A row's fields, opened under it: Selected at 35 %, a Focus frame at 50 % on the sides and the bottom. -->
  <Style Selector="Border.row-details">
    <Setter Property="Background" Value="{StaticResource Planner.DetailFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource Planner.DetailFrame}" />
    <Setter Property="BorderThickness" Value="1,0,1,1" />
    <Setter Property="Padding" Value="44,4,10,8" />
  </Style>
  <Style Selector="Button.row-action lucide|LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
</Styles>
