<!-- The geofence editor, as the KetrasPlanner panel: GEOFENCES holds the polygon and circle tools (lit while their map
     tool waits) over the fence list, each row coloured like its fence on the map and opening into its type and radius;
     the vehicle's breach settings follow in their own section while a vehicle is connected. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:planning="using:Ketras.App.Planning"
             xmlns:common="using:Ketras.App.Common"
             xmlns:setup="using:Ketras.App.Setup"
             xmlns:r="using:Ketras.App.Resources"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="Ketras.App.Planning.FencePanelView"
             x:DataType="planning:FencePanelViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Ketras/Planning/PlanningStyles.axaml" />
  </UserControl.Styles>

  <StackPanel>
    <common:CollapsibleSection Title="{x:Static r:Strings.PlanningFences}">
      <common:CollapsibleSection.Actions>
        <Button x:Name="ClearFences" Classes="row-action" Command="{Binding ClearFencesCommand}" ToolTip.Tip="{x:Static r:Strings.PlanningClearFencesTip}" ToolTip.Placement="Pointer">
          <lucide:LucideIcon Kind="Trash" Size="{StaticResource Size.RowIcon}" />
        </Button>
      </common:CollapsibleSection.Actions>
      <StackPanel Margin="0,0,0,6">
        <UniformGrid Rows="1" Margin="12,4,12,6">
          <Button x:Name="DrawPolygon" Classes="tool-face" Classes.armed="{Binding IsPolygonArmed}" Command="{Binding DrawPolygonCommand}" Margin="0,0,2,0"
                  ToolTip.Tip="{x:Static r:Strings.PlanningDrawPolygon}" ToolTip.Placement="Pointer">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Pentagon" Size="{StaticResource Size.RowIcon}" Foreground="{DynamicResource Brush.KeepOut}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static r:Strings.PlanningPolygonTool}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="DrawCircle" Classes="tool-face" Classes.armed="{Binding IsCircleArmed}" Command="{Binding DrawCircleCommand}" Margin="2,0,0,0"
                  ToolTip.Tip="{x:Static r:Strings.PlanningDrawCircle}" ToolTip.Placement="Pointer">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Circle" Size="{StaticResource Size.RowIcon}" Foreground="{DynamicResource Brush.KeepOut}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static r:Strings.PlanningCircleTool}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>

        <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="Fences" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="planning:FenceRowViewModel">
                <StackPanel>
                  <Button Classes="item-row" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                      <Border Classes="row-bar" Background="{Binding IsStayIn, Converter={x:Static common:Converters.FenceKindBrush}}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="{Binding Icon, Converter={x:Static common:Converters.Icon}}" Size="{StaticResource Size.RowIcon}"
                                           Foreground="{Binding IsStayIn, Converter={x:Static common:Converters.FenceKindBrush}}" VerticalAlignment="Center" />
                        <TextBlock Classes="row-name" Text="{Binding Id}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="row-value" Text="{Binding Summary}" MaxWidth="150" />
                      <StackPanel Grid.Column="3" Classes="row-actions" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="row-action" Command="{Binding DeleteCommand}" ToolTip.Tip="{x:Static r:Strings.PlanningDeleteFence}" ToolTip.Placement="Pointer">
                          <lucide:LucideIcon Kind="X" Size="{StaticResource Size.RowIcon}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Border Classes="row-details" IsVisible="{Binding IsSelected}">
                    <StackPanel Spacing="1">
                      <planning:FieldRowView DataContext="{Binding Kind}" />
                      <Panel IsVisible="{Binding IsCircle}">
                        <planning:FieldRowView DataContext="{Binding Radius}" />
                      </Panel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </common:CollapsibleSection>

    <Panel IsVisible="{Binding Breach.IsVisible}">
      <common:CollapsibleSection x:Name="Breach" Title="{Binding Breach.Title}">
        <StackPanel Margin="0,0,0,8">
          <ItemsControl ItemsSource="{Binding Breach.Shown}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="setup:ParameterFieldViewModel">
                <setup:ParameterFieldView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid x:Name="BreachApply" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="20,4,12,0" IsVisible="{Binding Pending.HasPending}">
            <TextBlock Classes="small" Text="{Binding Pending.PendingText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="primary" Content="{x:Static r:Strings.SetupApply}" Command="{Binding Pending.ApplyCommand}" IsEnabled="{Binding Pending.CanApply}" />
            <Button Grid.Column="2" Content="{x:Static r:Strings.SetupDiscard}" Command="{Binding Pending.DiscardCommand}" />
          </Grid>
        </StackPanel>
      </common:CollapsibleSection>
    </Panel>
  </StackPanel>
</UserControl>
