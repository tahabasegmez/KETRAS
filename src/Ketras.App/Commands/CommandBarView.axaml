<!-- The command bar along the top of the window: tool buttons (icon 16) in groups with a separator between them.
     The vehicle's current mode is the active tool; a request's result frames its button for a moment (pending Info,
     accepted Success, refused Error, no response Warning). A command with a question or inputs asks in a flyout. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commands="using:Ketras.App.Commands"
             xmlns:common="using:Ketras.App.Common"
             xmlns:r="using:Ketras.App.Resources"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="Ketras.App.Commands.CommandBarView"
             x:DataType="commands:CommandBarViewModel">
  <UserControl.Styles>
    <Style Selector="Button.tool.command /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tool.command.pending /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
    </Style>
    <Style Selector="Button.tool.command.accepted /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
    </Style>
    <Style Selector="Button.tool.command.rejected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
    </Style>
    <Style Selector="Button.tool.command.no-response /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
    </Style>
  </UserControl.Styles>

  <Border Height="36" Padding="8,0" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
    <ItemsControl x:Name="Buttons" ItemsSource="{Binding Buttons}" VerticalAlignment="Center">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="commands:CommandButtonViewModel">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource Brush.Border}" IsVisible="{Binding StartsGroup}" />
            <Panel ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True">
              <Button Classes="tool command" Classes.active="{Binding IsActiveMode}" Classes.pending="{Binding IsPending}"
                      Classes.accepted="{Binding IsAccepted}" Classes.rejected="{Binding IsRejected}" Classes.no-response="{Binding IsNoResponse}"
                      IsVisible="{Binding RunsDirectly}" IsEnabled="{Binding IsEnabled}" Command="{Binding RunCommand}">
                <lucide:LucideIcon Kind="{Binding Icon, Converter={x:Static common:Converters.Icon}}" Size="{StaticResource Size.ToolIcon}" />
              </Button>
              <Button Classes="tool command" Classes.active="{Binding IsActiveMode}" Classes.pending="{Binding IsPending}"
                      Classes.accepted="{Binding IsAccepted}" Classes.rejected="{Binding IsRejected}" Classes.no-response="{Binding IsNoResponse}"
                      IsVisible="{Binding NeedsConfirmation}" IsEnabled="{Binding IsEnabled}">
                <lucide:LucideIcon Kind="{Binding Icon, Converter={x:Static common:Converters.Icon}}" Size="{StaticResource Size.ToolIcon}" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Width="260" Spacing="8">
                      <TextBlock Classes="title" Text="{Binding Label}" />
                      <TextBlock Classes="wrap" Text="{Binding ConfirmationText}" IsVisible="{Binding HasConfirmationText}" />
                      <ItemsControl ItemsSource="{Binding Inputs}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="commands:CommandInputViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,6">
                              <TextBlock Classes="small" Text="{Binding Label}" />
                              <TextBox Text="{Binding Value}" FontFamily="{StaticResource Font.Mono}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button Content="{x:Static r:Strings.Cancel}" Click="OnCloseFlyout" />
                        <Button Classes="primary" Content="{x:Static r:Strings.CommandConfirm}" Click="OnConfirm" />
                      </StackPanel>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Panel>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>
