<!-- The shell (docs/UI_RULES.md "Activity bar", "Status bar"): the command bar along the top, the activity bar at the
     left, one activity in the work area with the toasts over it, the status bar along the bottom. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Ketras.App.Shell"
        xmlns:notifications="using:Ketras.App.Notifications"
        xmlns:commands="using:Ketras.App.Commands"
        xmlns:common="using:Ketras.App.Common"
        xmlns:r="using:Ketras.App.Resources"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="Ketras.App.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="{Binding Title}"
        Width="1600" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- Activity buttons: 48 square, frameless, icon 22 in Muted; the active one TextStrong with a 2 px Accent marker. -->
    <Style Selector="Button.activity">
      <Setter Property="Width" Value="{StaticResource Size.ActivityButton}" />
      <Setter Property="Height" Value="{StaticResource Size.ActivityButton}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.activity /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.activity:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.activity:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.activity lucide|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style Selector="Button.activity:pointerover lucide|LucideIcon, Button.activity.active lucide|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
    </Style>
    <Style Selector="Button.activity Border.marker">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.activity.active Border.marker">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- The vehicle link item: no fill, Connecting Accent at 25 %, Connected the Accent fill, Link lost Error at 25 %. -->
    <Style Selector="Button.link.connecting">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentFill}" />
    </Style>
    <Style Selector="Button.link.connected">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
    </Style>
    <Style Selector="Button.link.lost">
      <Setter Property="Background" Value="{DynamicResource Brush.ErrorFill}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
    </Style>
    <Style Selector="Button.vehicle">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Height="{StaticResource Size.RowHeight}"
            Background="{DynamicResource Brush.Chrome}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
      <DockPanel>
        <Button x:Name="LinkItem"
                DockPanel.Dock="Left"
                Classes="status-item link"
                Classes.connecting="{Binding LinkStatus.IsConnecting}"
                Classes.connected="{Binding LinkStatus.IsConnected}"
                Classes.lost="{Binding LinkStatus.IsLost}"
                Command="{Binding LinkStatus.OpenCommand}"
                ToolTip.Tip="{Binding LinkStatus.Tip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Plug" Size="{StaticResource Size.RowIcon}" Foreground="{Binding $parent[Button].Foreground}" />
            <TextBlock x:Name="LinkText" Text="{Binding LinkStatus.Text}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button x:Name="VehicleItem"
                DockPanel.Dock="Left"
                Classes="status-item vehicle"
                IsVisible="{Binding VehicleStatus.HasVehicle}"
                ToolTip.Tip="{x:Static r:Strings.VehicleItemTip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Plane" Size="{StaticResource Size.RowIcon}" Foreground="{Binding $parent[Button].Foreground}" />
            <TextBlock Text="{Binding VehicleStatus.ActiveName}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft">
              <ItemsControl ItemsSource="{Binding VehicleStatus.Choices}" MinWidth="200">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="shell:VehicleChoice">
                    <Button Classes="ghost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).VehicleStatus.SelectCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel Width="{StaticResource Size.RowIcon}">
                          <lucide:LucideIcon Kind="Check" Size="{StaticResource Size.RowIcon}" IsVisible="{Binding IsActive}" />
                        </Panel>
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- Flight items: GPS, link loss, time since arming; Warning / Error text from their checks. -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsVisible="{Binding FlightBar.HasVehicle}">
          <StackPanel.Styles>
            <Style Selector="Button.status-item.warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></Style>
            <Style Selector="Button.status-item.error"><Setter Property="Foreground" Value="{DynamicResource Brush.Error}" /></Style>
          </StackPanel.Styles>
          <Button x:Name="GpsItem" Classes="status-item" Classes.warning="{Binding FlightBar.IsGpsWarning}" Classes.error="{Binding FlightBar.IsGpsError}"
                  ToolTip.Tip="{Binding FlightBar.GpsTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Satellite" Size="{StaticResource Size.RowIcon}" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding FlightBar.Gps}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="LossItem" Classes="status-item" Classes.warning="{Binding FlightBar.IsLinkWarning}" Classes.error="{Binding FlightBar.IsLinkError}"
                  IsVisible="{Binding FlightBar.HasLink}" ToolTip.Tip="{Binding FlightBar.LinkTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Signal" Size="{StaticResource Size.RowIcon}" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding FlightBar.Link}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="FlightTimeItem" Classes="status-item" IsVisible="{Binding FlightBar.IsArmed}" ToolTip.Tip="{x:Static r:Strings.StatusFlightTime}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Clock" Size="{StaticResource Size.RowIcon}" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Classes="mono" Text="{Binding FlightBar.FlightTime}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <notifications:NotificationCenterView DockPanel.Dock="Right" DataContext="{Binding NotificationCenter}" />
        <Panel />
      </DockPanel>
    </Border>

    <commands:CommandBarView DockPanel.Dock="Top" DataContext="{Binding CommandBar}" />

    <Grid ColumnDefinitions="Auto,*">
      <!-- Activity bar -->
      <Border Background="{DynamicResource Brush.Chrome}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <Button DockPanel.Dock="Bottom"
                  Classes="activity"
                  Classes.active="{Binding SettingsActivity.IsSelected}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{Binding SettingsActivity}"
                  ToolTip.Tip="{Binding SettingsActivity.Title}"
                  ToolTip.Placement="Right">
            <Panel>
              <Border Classes="marker" Width="2" HorizontalAlignment="Left" />
              <lucide:LucideIcon Kind="{Binding SettingsActivity.Icon, Converter={x:Static common:Converters.Icon}}"
                                 Size="{StaticResource Size.ActivityIcon}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Button>
          <ItemsControl x:Name="ActivityBar" ItemsSource="{Binding Activities}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="shell:ActivityViewModel">
                <Button Classes="activity"
                        Classes.active="{Binding IsSelected}"
                        Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).SelectCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Title}"
                        ToolTip.Placement="Right">
                  <Panel>
                    <Border Classes="marker" Width="2" HorizontalAlignment="Left" />
                    <lucide:LucideIcon Kind="{Binding Icon, Converter={x:Static common:Converters.Icon}}"
                                       Size="{StaticResource Size.ActivityIcon}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- Work area: one activity, the toasts over it. -->
      <Panel Grid.Column="1">
        <ContentControl x:Name="WorkArea" Content="{Binding SelectedActivity.Content}" />
        <notifications:ToastsView DataContext="{Binding Toasts}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,16,16" />
      </Panel>
    </Grid>
  </DockPanel>
</Window>
