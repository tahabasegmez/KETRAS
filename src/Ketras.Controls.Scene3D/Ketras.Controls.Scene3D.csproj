<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A 3D airspace view for Avalonia: GPU terrain under a software scene of volumes, the planned route, points of interest and aircraft.</Description>
    <PackageTags>avalonia;3d;terrain;gcs;uav</PackageTags>
    <!-- TerrainView passes vertex data and matrices to OpenGL by pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="HelixToolkit.Maths" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ketras.Model\Ketras.Model.csproj" />
    <ProjectReference Include="..\Ketras.Theme\Ketras.Theme.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ketras.Tests" />
  </ItemGroup>
</Project>
