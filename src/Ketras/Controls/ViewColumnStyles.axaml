<!-- The view column's square toggles over the map (Planning and 3D): 28 px, radius 4, no frame until lit; lit, the
     Accent frame over an Accent tint and the icon in TextStrong. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="using:Lucide.Avalonia">
  <Styles.Resources>
    <SolidColorBrush x:Key="ViewToggle.OnFill" Color="{DynamicResource Color.Accent}" Opacity="0.25" />
  </Styles.Resources>

  <Style Selector="Button.view-toggle">
    <Setter Property="Width" Value="{StaticResource Size.ToolButton}" />
    <Setter Property="Height" Value="{StaticResource Size.ToolButton}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.view-toggle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.view-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ViewToggle.OnFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.view-toggle lucide|LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Faint}" />
  </Style>
  <Style Selector="Button.view-toggle.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ViewToggle.OnFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.view-toggle.on lucide|LucideIcon, Button.view-toggle:pointerover lucide|LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextStrong}" />
  </Style>
</Styles>
