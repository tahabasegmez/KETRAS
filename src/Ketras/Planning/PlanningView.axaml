<!-- The Planning activity, laid out as the KetrasPlanner control: the map fills the work area and every panel floats over
     it. Top left, the planning panel (300 wide): the Mission / Geofence switch and the collapse chevron in its title row,
     the chosen editor under it. Top right, the view column (satellite / street, then the layers, then the terrain download
     while terrain is downloaded by hand and the plan's area lacks it, then follow and fit, then the data credits on
     hover); bottom right, the telemetry panel; bottom left, the weather. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:planning="using:Ketras.Planning"
             xmlns:missions="using:Ketras.Planning.Missions"
             xmlns:fences="using:Ketras.Planning.Fences"
             xmlns:telemetry="using:Ketras.Telemetry"
             xmlns:weather="using:Ketras.Environment.Weather"
             xmlns:map="using:Ketras.Controls.Map"
             xmlns:r="using:Ketras.Resources"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="Ketras.Planning.PlanningView"
             x:DataType="planning:PlanningViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Ketras/Controls/ViewColumnStyles.axaml" />
    <StyleInclude Source="avares://Ketras/Planning/PlanningStyles.axaml" />
  </UserControl.Styles>

  <Panel Background="{DynamicResource Brush.MapGround}">
    <map:MapView x:Name="Map"
                 Plan="{Binding Plan}" Zones="{Binding Zones}" Points="{Binding Points}" TerrainConflicts="{Binding TerrainConflicts}"
                 SelectedItemId="{Binding SelectedItemId}" SelectedFenceId="{Binding SelectedFenceId}" ExecutingItemIndex="{Binding ExecutingItemIndex}"
                 Tool="{Binding Tool}" BaseMap="{Binding BaseMap}" Layers="{Binding Layers}" FollowOwnship="{Binding FollowVehicle}"
                 TileCacheDirectory="{Binding TileCacheDirectory}" CustomTiles="{Binding CustomTiles}"
                 PlaceItemCommand="{Binding PlaceItemCommand}" MoveItemCommand="{Binding MoveItemCommand}" MoveApproachCommand="{Binding MoveApproachCommand}"
                 AddFenceCommand="{Binding AddFenceCommand}" EditFenceCommand="{Binding EditFenceCommand}"
                 DrawingDiscardedCommand="{Binding DrawingDiscardedCommand}"
                 Guides="{Binding Guides}" ResizeOrbitCommand="{Binding ResizeOrbitCommand}" />

    <!-- The planning panel: the switch picks the editor below it. -->
    <Border x:Name="PlanningPanel" Classes="floating" Width="300" Padding="0" ClipToBounds="True"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto">
        <Border Classes="panel-switch">
          <Grid x:Name="SwitchGrid" ColumnDefinitions="*,*">
            <Border x:Name="SwitchHighlight" Classes="switch-highlight" Grid.ColumnSpan="2" />
            <Button x:Name="MissionTab" Classes="switch-half" Classes.active="{Binding IsMissionPanel}" Command="{Binding ShowMissionPanelCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <lucide:LucideIcon Kind="Route" Size="{StaticResource Size.RowIcon}" VerticalAlignment="Center" />
                <TextBlock Classes="switch-label" Text="{x:Static r:Strings.PlanningMissionTab}" />
              </StackPanel>
            </Button>
            <Button x:Name="GeofenceTab" Grid.Column="1" Classes="switch-half" Classes.active="{Binding IsGeofencePanel}" Command="{Binding ShowGeofencePanelCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <lucide:LucideIcon Kind="Fence" Size="{StaticResource Size.RowIcon}" VerticalAlignment="Center" />
                <TextBlock Classes="switch-label" Text="{x:Static r:Strings.PlanningGeofenceTab}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <Button x:Name="TogglePanel" Grid.Column="1" Classes="row-action" Margin="0,0,6,0" VerticalAlignment="Center" Command="{Binding TogglePanelCommand}"
                ToolTip.Tip="{x:Static r:Strings.PlanningTogglePanel}" ToolTip.Placement="Pointer">
          <Panel>
            <lucide:LucideIcon Kind="ChevronUp" Size="{StaticResource Size.RowIcon}" IsVisible="{Binding IsPanelExpanded}" />
            <lucide:LucideIcon Kind="ChevronDown" Size="{StaticResource Size.RowIcon}" IsVisible="{Binding !IsPanelExpanded}" />
          </Panel>
        </Button>
        </Grid>
        <Grid x:Name="PlanningContent" ClipToBounds="True" IsVisible="{Binding IsPanelExpanded}">
          <missions:MissionPanelView x:Name="MissionPanel" DataContext="{Binding Mission}" />
          <fences:FencePanelView x:Name="FencePanel" DataContext="{Binding Fences}" IsVisible="False" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Top right: the view column. -->
    <Border x:Name="ViewColumn" Classes="floating" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
        <StackPanel Spacing="2">
          <Button x:Name="SwitchBaseMap" Classes="view-toggle on" Command="{Binding SwitchBaseMapCommand}" IsEnabled="{Binding CanSwitchBaseMap}">
            <Panel>
              <lucide:LucideIcon Kind="Earth" Size="{StaticResource Size.ToolIcon}" IsVisible="{Binding IsSatellite}" ToolTip.Tip="{x:Static r:Strings.MapSatellite}" ToolTip.Placement="Pointer" />
              <lucide:LucideIcon Kind="Map" Size="{StaticResource Size.ToolIcon}" IsVisible="{Binding !IsSatellite}" ToolTip.Tip="{x:Static r:Strings.MapStreet}" ToolTip.Placement="Pointer" />
            </Panel>
          </Button>
          <Border Height="1" Margin="2" Background="{DynamicResource Brush.Border}" />
          <Button Classes="view-toggle" Classes.on="{Binding ShowBaseMap}" Command="{Binding ToggleBaseMapLayerCommand}" ToolTip.Tip="{x:Static r:Strings.MapBaseMap}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="Layers" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Button Classes="view-toggle" Classes.on="{Binding ShowFences}" Command="{Binding ToggleFenceLayerCommand}" ToolTip.Tip="{x:Static r:Strings.MapFences}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="Fence" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Button Classes="view-toggle" Classes.on="{Binding ShowMission}" Command="{Binding ToggleMissionLayerCommand}" ToolTip.Tip="{x:Static r:Strings.MapMission}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="Route" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Button Classes="view-toggle" Classes.on="{Binding ShowVehicle}" Command="{Binding ToggleVehicleLayerCommand}" ToolTip.Tip="{x:Static r:Strings.MapVehicle}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="Plane" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Button Classes="view-toggle" Classes.on="{Binding ShowTraffic}" Command="{Binding ToggleTrafficLayerCommand}" ToolTip.Tip="{x:Static r:Strings.MapTraffic}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="Radar" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Button x:Name="ToggleGuides" Classes="view-toggle" Classes.on="{Binding ShowGuides}" Command="{Binding ToggleGuidesLayerCommand}" ToolTip.Tip="{x:Static r:Strings.MapGuides}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="DraftingCompass" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Border Height="1" Margin="2" Background="{DynamicResource Brush.Border}" />
          <!-- Manual terrain download: only while cells of the plan's area are missing. -->
          <Button x:Name="DownloadTerrain" Classes="view-toggle" Classes.on="{Binding IsTerrainDownloading}" Command="{Binding DownloadTerrainCommand}"
                  IsVisible="{Binding ShowTerrainDownload}" ToolTip.Tip="{Binding TerrainDownloadTip}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="CloudDownload" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Button x:Name="Follow" Classes="view-toggle" Classes.on="{Binding FollowVehicle}" Command="{Binding ToggleFollowCommand}" ToolTip.Tip="{x:Static r:Strings.MapFollow}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="Crosshair" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Button x:Name="Fit" Classes="view-toggle" Command="{Binding FitCommand}" ToolTip.Tip="{x:Static r:Strings.MapFit}" ToolTip.Placement="Pointer">
            <lucide:LucideIcon Kind="Scan" Size="{StaticResource Size.ToolIcon}" />
          </Button>
          <Border Height="1" Margin="2" Background="{DynamicResource Brush.Border}" />
          <!-- The base map's and the terrain data's credits, as their licences require, on hover. -->
          <Border x:Name="Credits" Background="Transparent" Height="{StaticResource Size.ToolButton}" ToolTip.Placement="Left">
            <ToolTip.Tip>
              <StackPanel MaxWidth="360" Spacing="4">
                <TextBlock Classes="wrap" Text="{Binding #Map.Attribution}" />
                <TextBlock Classes="wrap" Text="{Binding TerrainAttribution}" IsVisible="{Binding TerrainAttribution, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </ToolTip.Tip>
            <lucide:LucideIcon Kind="Info" Size="{StaticResource Size.ToolIcon}" Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
    </Border>

    <!-- Bottom right: the telemetry. -->
    <telemetry:TelemetryPanelView x:Name="Telemetry" DataContext="{Binding Telemetry}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" />

    <!-- Bottom left: the weather. -->
    <weather:WeatherView DataContext="{Binding Weather}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" />
  </Panel>
</UserControl>
