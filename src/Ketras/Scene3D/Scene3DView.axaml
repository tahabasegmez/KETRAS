<!-- The 3D view activity: the scene fills the work area and every panel floats over it, 10 from the edges as in
     Planning. Top left, the traffic list (260 wide, only while there is traffic); top right, the view column (the
     terrain surface: grey relief, satellite or street, or the custom map while one is set; then follow and fit; then
     the data credits on hover); bottom right, the telemetry panel. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scene3d="using:Ketras.Scene3D"
             xmlns:telemetry="using:Ketras.Telemetry"
             xmlns:r="using:Ketras.Resources"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="Ketras.Scene3D.Scene3DView"
             x:DataType="scene3d:Scene3DViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Ketras/Controls/ViewColumnStyles.axaml" />
  </UserControl.Styles>

  <Panel Background="{DynamicResource Brush.MapGround}">
    <scene3d:AirspaceView x:Name="Scene" />

    <!-- Top left: the traffic list. -->
    <Border x:Name="TrafficPanel" Classes="floating" Width="260" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" IsVisible="{Binding HasTraffic}">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Height="30" Margin="12,0,8,0">
          <TextBlock Classes="panel-title" Text="{x:Static r:Strings.SceneTraffic}" VerticalAlignment="Center" />
          <Border Grid.Column="1" Classes="badge neutral" VerticalAlignment="Center"><TextBlock Text="{Binding TrafficCount}" /></Border>
        </Grid>
        <ItemsControl ItemsSource="{Binding TrafficRows}" Margin="0,0,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="scene3d:TrafficRow">
              <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{StaticResource Size.RowHeight}"
                      MinHeight="0" CornerRadius="0"
                      Command="{Binding $parent[UserControl].((scene3d:Scene3DViewModel)DataContext).FollowTrafficCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="2,*,Auto">
                  <Border Background="{DynamicResource Brush.Landing}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Classes="small" Text="{Binding Detail}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="small mono" Text="{Binding Altitude}" Margin="0,0,8,0" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Top right: the view column. -->
    <Border x:Name="ViewColumn" Classes="floating" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
      <StackPanel Spacing="2">
        <Button x:Name="SurfaceGrey" Classes="view-toggle" Classes.on="{Binding IsGrey}" Command="{Binding ShowGreyCommand}"
                ToolTip.Tip="{x:Static r:Strings.SceneSurfaceGrey}" ToolTip.Placement="Pointer">
          <lucide:LucideIcon Kind="Mountain" Size="{StaticResource Size.ToolIcon}" />
        </Button>
        <Button x:Name="SurfaceSatellite" Classes="view-toggle" Classes.on="{Binding IsSatellite}" Command="{Binding ShowSatelliteCommand}" IsVisible="{Binding !HasCustomTiles}"
                ToolTip.Tip="{x:Static r:Strings.SceneSurfaceSatellite}" ToolTip.Placement="Pointer">
          <lucide:LucideIcon Kind="Earth" Size="{StaticResource Size.ToolIcon}" />
        </Button>
        <Button x:Name="SurfaceStreet" Classes="view-toggle" Classes.on="{Binding IsStreet}" Command="{Binding ShowStreetCommand}" IsVisible="{Binding !HasCustomTiles}"
                ToolTip.Tip="{x:Static r:Strings.SceneSurfaceStreet}" ToolTip.Placement="Pointer">
          <lucide:LucideIcon Kind="Map" Size="{StaticResource Size.ToolIcon}" />
        </Button>
        <Button x:Name="SurfaceCustom" Classes="view-toggle" Classes.on="{Binding IsCustom}" Command="{Binding ShowCustomCommand}" IsVisible="{Binding HasCustomTiles}"
                ToolTip.Tip="{x:Static r:Strings.SceneSurfaceCustom}" ToolTip.Placement="Pointer">
          <lucide:LucideIcon Kind="Layers" Size="{StaticResource Size.ToolIcon}" />
        </Button>
        <Border Height="1" Margin="2" Background="{DynamicResource Brush.Border}" />
        <Button x:Name="Follow" Classes="view-toggle" Classes.on="{Binding Followed, Converter={x:Static ObjectConverters.IsNotNull}}" Command="{Binding FollowOwnshipCommand}"
                ToolTip.Tip="{x:Static r:Strings.SceneFollowVehicle}" ToolTip.Placement="Pointer">
          <lucide:LucideIcon Kind="Crosshair" Size="{StaticResource Size.ToolIcon}" />
        </Button>
        <Button x:Name="FitAll" Classes="view-toggle" Command="{Binding FitCommand}" ToolTip.Tip="{x:Static r:Strings.SceneFit}" ToolTip.Placement="Pointer">
          <lucide:LucideIcon Kind="Scan" Size="{StaticResource Size.ToolIcon}" />
        </Button>
        <Border Height="1" Margin="2" Background="{DynamicResource Brush.Border}" />
        <!-- The terrain data's and the imagery's credits, as their licences require, on hover. -->
        <Border x:Name="Credits" Background="Transparent" Height="{StaticResource Size.ToolButton}" ToolTip.Tip="{Binding Credits}" ToolTip.Placement="Left">
          <lucide:LucideIcon Kind="Info" Size="{StaticResource Size.ToolIcon}" Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>

    <!-- Bottom right: the telemetry. -->
    <telemetry:TelemetryPanelView x:Name="Telemetry" DataContext="{Binding Telemetry}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" />
  </Panel>
</UserControl>
