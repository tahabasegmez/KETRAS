<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Ketras</AssemblyName>
    <RootNamespace>Ketras</RootNamespace>
    <Description>Ketras ground control station: the desktop application.</Description>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Lucide.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ketras.Model\Ketras.Model.csproj" />
    <ProjectReference Include="..\Ketras.Mavlink\Ketras.Mavlink.csproj" />
    <ProjectReference Include="..\Ketras.Rosbridge\Ketras.Rosbridge.csproj" />
    <ProjectReference Include="..\Ketras.Terrain\Ketras.Terrain.csproj" />
    <ProjectReference Include="..\Ketras.Theme\Ketras.Theme.csproj" />
    <ProjectReference Include="..\Ketras.Controls.Instruments\Ketras.Controls.Instruments.csproj" />
    <ProjectReference Include="..\Ketras.Controls.Scene3D\Ketras.Controls.Scene3D.csproj" />
    <ProjectReference Include="..\Ketras.Controls.Map\Ketras.Controls.Map.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Ketras.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Simulation\Px4Sitl\scripts\**" Link="sitl\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ketras.Tests" />
  </ItemGroup>

  <!-- A custom build (QGroundControl's QGC_CUSTOM_DIR): the C# sources in <KetrasCustomDir>/src, a folder relative to the
       repository root ("custom" unless set, e.g. -p:KetrasCustomDir=custom-example), are compiled into the application. -->
  <PropertyGroup>
    <KetrasCustomDir Condition="'$(KetrasCustomDir)' == ''">custom</KetrasCustomDir>
    <KetrasCustomSources>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..', '$(KetrasCustomDir)', 'src'))</KetrasCustomSources>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(KetrasCustomSources)')">
    <Compile Include="$(KetrasCustomSources)**\*.cs" Link="Custom\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
