<!-- The Radio page: the calibration card (instruction, Calibrate / Next / Cancel, Copy trims), the channel monitor (a bar
     per channel with its PWM and mapped stick), then the assignment, mode and switch sections with their live chips. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setup="using:Ketras.Setup"
             xmlns:parameters="using:Ketras.Parameters"
             xmlns:r="using:Ketras.Resources"
             x:Class="Ketras.Setup.RadioPageView"
             x:DataType="setup:RadioPageViewModel">
  <UserControl.Styles>
    <Style Selector="Border.chip">
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
    <Style Selector="Border.chip.active">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Padding="0,0,10,12">
    <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock Classes="small wrap" Text="{Binding InputNote}" IsVisible="{Binding InputNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Classes="section"><TextBlock Text="{x:Static r:Strings.RadioCalibration}" /></Border>
      <Border x:Name="Wizard" Classes="card" Margin="20,0,12,0">
        <StackPanel Spacing="8">
          <TextBlock x:Name="Instruction" Classes="wrap" Text="{Binding Instruction}" IsVisible="{Binding IsCalibrating}" MinHeight="34" />
          <TextBlock Classes="small wrap" Text="{x:Static r:Strings.RadioIntro}" IsVisible="{Binding !IsCalibrating}" />
          <Border Classes="error-box" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="{Binding Error}" /></Border>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="Calibrate" Classes="primary" Content="{x:Static r:Strings.SensorsCalibrate}" Command="{Binding CalibrateCommand}" IsVisible="{Binding !IsCalibrating}" IsEnabled="{Binding CanStart}" />
            <Button Content="{x:Static r:Strings.RadioCopyTrims}" Command="{Binding CopyTrimsCommand}" IsVisible="{Binding !IsCalibrating}" IsEnabled="{Binding CanStart}"
                    ToolTip.Tip="{x:Static r:Strings.RadioCopyTrimsTip}" />
            <Button x:Name="Next" Classes="primary" Content="{x:Static r:Strings.RadioNext}" Command="{Binding NextCommand}" IsVisible="{Binding IsCalibrating}" IsEnabled="{Binding CanNext}" />
            <Button Classes="danger" Content="{x:Static r:Strings.Cancel}" Command="{Binding CancelCalibrationCommand}" IsVisible="{Binding IsCalibrating}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="section"><TextBlock Text="{x:Static r:Strings.RadioMonitor}" /></Border>
      <TextBlock Classes="small" Text="{x:Static r:Strings.RadioNoInput}" IsVisible="{Binding NoInput}" Margin="20,0,12,0" />
      <ItemsControl x:Name="Channels" ItemsSource="{Binding Channels}" Margin="20,0,12,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="setup:ChannelBarViewModel">
            <Grid ColumnDefinitions="44,*,52,90" Height="18" ColumnSpacing="6">
              <TextBlock Classes="caption mono" Text="{Binding Label}" VerticalAlignment="Center" />
              <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Fraction}" VerticalAlignment="Center" MinHeight="6" Height="6" />
              <TextBlock Grid.Column="2" Classes="caption mono" Text="{Binding Value}" TextAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="caption" Text="{Binding Function}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding Mapping.IsVisible}">
        <Border Classes="section" Margin="0,6,0,0"><TextBlock Text="{Binding Mapping.Title}" /></Border>
        <ItemsControl ItemsSource="{Binding Mapping.Shown}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="parameters:ParameterFieldViewModel"><parameters:ParameterFieldView /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding Modes.IsVisible}">
        <Border Classes="section" Margin="0,6,0,0"><TextBlock Text="{Binding Modes.Title}" /></Border>
        <ItemsControl x:Name="Slots" ItemsSource="{Binding Slots}" Margin="20,4,12,4">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="setup:LiveChipViewModel">
              <Border Classes="chip" Classes.active="{Binding IsActive}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="small mono" Text="{Binding Label}" />
                  <TextBlock Classes="small" Text="{Binding Detail}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Modes.Shown}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="parameters:ParameterFieldViewModel"><parameters:ParameterFieldView /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding Switches.IsVisible}">
        <Border Classes="section" Margin="0,6,0,0"><TextBlock Text="{Binding Switches.Title}" /></Border>
        <ItemsControl x:Name="SwitchStates" ItemsSource="{Binding SwitchStates}" Margin="20,4,12,4">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="setup:LiveChipViewModel">
              <Border Classes="chip" Classes.active="{Binding IsActive}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="small" Text="{Binding Label}" />
                  <TextBlock Classes="small mono" Text="{Binding Detail}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Switches.Shown}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="parameters:ParameterFieldViewModel"><parameters:ParameterFieldView /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
