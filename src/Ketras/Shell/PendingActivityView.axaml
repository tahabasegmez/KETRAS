<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Ketras.Shell"
             xmlns:r="using:Ketras.Resources"
             x:Class="Ketras.Shell.PendingActivityView"
             x:DataType="shell:PendingActivityViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
    <TextBlock Classes="page-title" HorizontalAlignment="Center" Text="{Binding Title}" />
    <TextBlock Classes="small" HorizontalAlignment="Center" Text="{x:Static r:Strings.PendingActivity}" />
  </StackPanel>
</UserControl>
