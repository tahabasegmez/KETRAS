<!-- The Links page: the saved links (the one in use on Selected with a Focus edge) and the editor card, which keeps a
     fixed width and fixed rows so picking another type or showing an error moves nothing. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comms="using:Ketras.Comms"
             xmlns:controls="using:Ketras.Controls"
             xmlns:r="using:Ketras.Resources"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="Ketras.Comms.LinksPageView"
             x:DataType="comms:LinksPageViewModel">
  <UserControl.Styles>
    <Style Selector="Border.link-row">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="6,0,4,0" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.link-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Border.link-row.in-use">
      <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    </Style>
    <Style Selector="Border.kind">
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
    </Style>
    <Style Selector="Border.kind > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.editor-field > TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style Selector="StackPanel.editor-field">
      <Setter Property="Spacing" Value="4" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="0,0,10,12">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <Border Classes="section"><TextBlock Text="{x:Static r:Strings.LinkSectionSaved}" /></Border>

      <TextBlock Classes="small" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Margin="8,4" />
      <ItemsControl x:Name="Profiles" ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="comms:LinkProfileRow">
            <Border Classes="link-row" Classes.in-use="{Binding IsInUse}" ToolTip.Tip="{Binding Summary}">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <lucide:LucideIcon Kind="{Binding Icon, Converter={x:Static controls:Converters.Icon}}" Size="{StaticResource Size.RowIcon}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="kind" VerticalAlignment="Center"><TextBlock Text="{Binding KindLabel}" /></Border>
                <TextBlock Grid.Column="3" Classes="caption mono" Text="{Binding Summary}" Margin="10,0,8,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static r:Strings.LinkInUse}" IsVisible="{Binding IsInUse}" Foreground="{DynamicResource Brush.Success}"
                             FontSize="{StaticResource FontSize.Small}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Classes="primary" IsVisible="{Binding CanConnect}"
                          Command="{Binding $parent[UserControl].((comms:LinksPageViewModel)DataContext).ConnectCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <lucide:LucideIcon Kind="Plug" Size="{StaticResource Size.RowIcon}" Foreground="{DynamicResource Brush.TextStrong}" />
                      <TextBlock Text="{x:Static r:Strings.Connect}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="row-action" ToolTip.Tip="{x:Static r:Strings.Edit}"
                          Command="{Binding $parent[UserControl].((comms:LinksPageViewModel)DataContext).EditCommand}" CommandParameter="{Binding}">
                    <lucide:LucideIcon Kind="Pencil" Size="{StaticResource Size.RowIcon}" />
                  </Button>
                  <Button Classes="row-action" ToolTip.Tip="{x:Static r:Strings.Remove}"
                          Command="{Binding $parent[UserControl].((comms:LinksPageViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                    <lucide:LucideIcon Kind="Trash" Size="{StaticResource Size.RowIcon}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button x:Name="NewLink" HorizontalAlignment="Left" Margin="8,6,0,0" Command="{Binding NewLinkCommand}" IsVisible="{Binding !IsEditing}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <lucide:LucideIcon Kind="Plus" Size="{StaticResource Size.RowIcon}" />
          <TextBlock Text="{x:Static r:Strings.LinkNew}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Editor -->
      <Panel IsVisible="{Binding IsEditing}">
      <Border x:Name="LinkEditor" Classes="card" Width="720" HorizontalAlignment="Left" Margin="0,8,0,0"
              DataContext="{Binding Editor}" x:DataType="comms:LinkEditorViewModel">
        <Grid ColumnDefinitions="*,120,200" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
          <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
            <TextBlock Classes="title" Text="{Binding Heading}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="row-action" Command="{Binding CancelCommand}" ToolTip.Tip="{x:Static r:Strings.Cancel}">
              <lucide:LucideIcon Kind="X" Size="{StaticResource Size.RowIcon}" />
            </Button>
          </Grid>

          <StackPanel Grid.Row="1" Classes="editor-field">
            <TextBlock Text="{x:Static r:Strings.FieldName}" />
            <TextBox x:Name="LinkName" Text="{Binding Name}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="editor-field">
            <TextBlock Text="{x:Static r:Strings.FieldLinkType}" />
            <ListBox x:Name="LinkType" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" Background="Transparent">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="comms:LinkKindChoice">
                  <TextBlock Text="{Binding Label}" MinWidth="40" TextAlignment="Center" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <!-- The type's fields, all in the same place. -->
          <Panel Grid.Row="2">
            <StackPanel Classes="editor-field" IsVisible="{Binding IsUdp}" ToolTip.Tip="{x:Static r:Strings.FieldHostUdpTip}">
              <TextBlock Text="{x:Static r:Strings.FieldHost}" />
              <TextBox Text="{Binding UdpHost}" />
            </StackPanel>
            <StackPanel Classes="editor-field" IsVisible="{Binding IsTcp}">
              <TextBlock Text="{x:Static r:Strings.FieldHost}" />
              <TextBox x:Name="TcpHost" Text="{Binding TcpHost}" />
            </StackPanel>
            <StackPanel Classes="editor-field" IsVisible="{Binding IsSerial}">
              <TextBlock Text="{x:Static r:Strings.FieldPort}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SerialPort}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Classes="row-action" Command="{Binding RescanPortsCommand}" ToolTip.Tip="{x:Static r:Strings.LinkRescan}" VerticalAlignment="Center">
                  <lucide:LucideIcon Kind="RefreshCw" Size="{StaticResource Size.RowIcon}" />
                </Button>
              </Grid>
            </StackPanel>
            <StackPanel Classes="editor-field" IsVisible="{Binding IsSimulator}">
              <TextBlock Text="{x:Static r:Strings.FieldSimulator}" />
              <ComboBox ItemsSource="{Binding Simulators}" SelectedItem="{Binding Simulator}" HorizontalAlignment="Stretch"
                        DisplayMemberBinding="{ReflectionBinding Name}" />
            </StackPanel>
          </Panel>
          <Panel Grid.Row="2" Grid.Column="1">
            <StackPanel Classes="editor-field" IsVisible="{Binding IsUdp}">
              <TextBlock Text="{x:Static r:Strings.FieldPort}" />
              <TextBox Text="{Binding UdpPort}" FontFamily="{StaticResource Font.Mono}" />
            </StackPanel>
            <StackPanel Classes="editor-field" IsVisible="{Binding IsTcp}">
              <TextBlock Text="{x:Static r:Strings.FieldPort}" />
              <TextBox x:Name="TcpPort" Text="{Binding TcpPort}" FontFamily="{StaticResource Font.Mono}" />
            </StackPanel>
            <StackPanel Classes="editor-field" IsVisible="{Binding IsSerial}">
              <TextBlock Text="{x:Static r:Strings.FieldBaudRate}" />
              <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Panel>
          <StackPanel Grid.Row="2" Grid.Column="2" Classes="editor-field">
            <TextBlock Text="{x:Static r:Strings.FieldAutopilot}" />
            <ComboBox ItemsSource="{Binding Autopilots}" SelectedItem="{Binding Autopilot}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Classes="small wrap" MaxLines="2" Height="34" Text="{Binding KindHint}" />
          <Panel Grid.Row="4" Grid.ColumnSpan="3" Height="28">
            <Border x:Name="EditorError" Classes="error-box" IsVisible="{Binding HasError}" VerticalAlignment="Center">
              <TextBlock Text="{Binding Error}" />
            </Border>
          </Panel>
          <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
            <Button x:Name="SaveAndConnect" Classes="primary" Content="{x:Static r:Strings.LinkSaveAndConnect}" Command="{Binding SaveAndConnectCommand}" />
            <Button x:Name="Save" Content="{x:Static r:Strings.Save}" Command="{Binding SaveCommand}" />
            <Button Content="{x:Static r:Strings.Cancel}" Command="{Binding CancelCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      </Panel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
