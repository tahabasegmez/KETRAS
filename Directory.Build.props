<Project>
  <!-- Shared by every project in the repository; tests/ refines it in its own Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>The Ketras contributors</Authors>
    <Copyright>Copyright (C) The Ketras contributors</Copyright>
    <Product>Ketras</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
